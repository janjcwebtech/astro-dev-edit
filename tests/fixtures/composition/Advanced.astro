---
import Rootless from './Rootless.astro';
import RecursiveSpread from './RecursiveSpread.astro';
import Forward from './Forward.astro';
import RepeatSlots from './RepeatSlots.astro';
import ForwardSlots from './ForwardSlots.astro';
import Mutating from './Mutating.astro';
import Delayed from './Delayed.astro';
import Card from './Card.astro';
import Shared from './Shared.astro';
import { TAGLINE } from './site-data.mjs';
const cards = [{ title: 'Card one' }, { title: 'Card two' }];
const intro = '<p data-rich-copy>Rich <b>intro</b> copy</p>';
---
<html><body>
  {[1, 2].map(label => <Rootless label={label} />)}
  <RecursiveSpread depth={2} />
  <Forward title="Protected" eyebrow={TAGLINE} />
  {cards.map((card, i) => <Card title={card.title} instance={`mapped-${i}`} />)}
  <Card title="Plain" instance="plain">Start a project</Card>
  <Shared />
  <Shared />
  <div data-rich set:html={intro}></div>
  <div data-rich-quoted set:html="<b data-rich-inner>Quoted &amp; raw</b>"></div>
  <RepeatSlots>
    <span data-repeated-slot>Repeated words</span>
    <Rootless slot="detail" label="slotted" />
  </RepeatSlots>
  <ForwardSlots>
    <span data-forwarded-slot>Forwarded words</span>
    <Rootless slot="detail" label="forwarded" />
  </ForwardSlots>
  <RepeatSlots />
  <Mutating />
  <Delayed delay={5} label="slow"><span data-delayed-slot="slow">Slow slot</span></Delayed>
  <Delayed delay={0} label="fast"><span data-delayed-slot="fast">Fast slot</span></Delayed>
</body></html>
