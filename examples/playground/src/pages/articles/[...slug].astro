---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// Deliberately emits **no** pageSource prop, unlike /works. This route is the
// auto-detection fixture: switch `blog` on in the Collections drawer and the
// entry drawer has to appear here with nothing declaring the backing file.
// /works keeps the meta tag, so one manual pass exercises both regimes.
---
<Base title={`${post.data.title} · Copydesk`} description={post.data.excerpt}>
  <article class="section">
    <div class="container prose">
      <a href="/articles" style="color:var(--accent);text-decoration:none;font-size:0.9rem;">&larr; All articles</a>
      <p class="eyebrow" style="margin-top:1rem;">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="meta" style="color:var(--grey);">By {post.data.author} · {fmt(post.data.date)} · {post.data.readTime}</p>
      <img src={post.data.image} alt={post.data.title} />
      <!-- Markdown body renders via <Content /> (an expression) — the editor
           should treat this as non-editable for now (spec §16.4). -->
      <Content />
    </div>
  </article>
</Base>
