---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

// Drafts stay reachable at their own URL (handy for testing the boolean
// field in the entry drawer) but are kept off the public listing.
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Articles · Copydesk">
  <section class="section">
    <div class="container">
      <!-- Literal intro copy (editable) -->
      <p class="eyebrow">The journal</p>
      <h1>Notes on visual editing</h1>
      <p class="lead" style="max-width:55ch;">
        Short pieces on editing where you read, how Astro sites hold their
        content, and what a browser-based workflow changes day to day.
      </p>

      <!-- Collection cards: mapped over real markdown (non-editable path) -->
      <div class="grid grid-3" style="margin-top:2.5rem;">
        {posts.map((post) => (
          <a class="article-card" href={`/articles/${post.id}`}>
            <img src={post.data.image} alt={post.data.title} />
            <div class="body">
              <p class="meta">{post.data.category} · {fmt(post.data.date)} · {post.data.readTime}</p>
              <h3>{post.data.title}</h3>
              <p>{post.data.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
