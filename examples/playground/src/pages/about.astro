---
import Base from '../layouts/Base.astro';

const voices = [
  { quote: 'I stopped sending screenshots with arrows pointing at typos. I just fix them now.', who: 'Maya Ortiz', role: 'Content lead (fictional)' },
  { quote: 'The part I trust most is what it refuses to touch. Generated text stays generated.', who: 'Jonas Falk', role: 'Developer (fictional)' },
  { quote: 'Editing in the browser and reviewing in git is the split of responsibilities we always wanted.', who: 'Priya Nair', role: 'Editor (fictional)' },
];
---
<Base title="About · Copydesk">
  <section class="section">
    <div class="container">
      <p class="eyebrow">About this site</p>
      <h1>A place made to be clicked on</h1>
      <p class="lead" style="max-width:60ch;">
        Copydesk is the playground for a visual editing tool for Astro. Nothing
        here is real (no company, no clients, no newsletter), but every
        section exists for a reason: headings and paragraphs you can edit,
        images you can swap, and generated content that should politely refuse.
      </p>
    </div>
  </section>

  <!-- Persona: static image + literal name/role -->
  <section class="section" style="padding-top:0;">
    <div class="container split">
      <div class="team-member" style="gap:1.25rem;">
        <img src="/images/portrait.svg" alt="Abstract placeholder portrait" style="width:96px;height:96px;" />
        <div>
          <h3 style="margin:0;">Alex Sand</h3>
          <p style="margin:0;">Fictional editor-in-chief of this playground</p>
        </div>
      </div>
      <div>
        <h2>What this site is for</h2>
        <p>
          Every page doubles as a test fixture. If you are trying the editor,
          this is the safe place to break things: edits land in the
          playground's own files, and git puts everything back.
        </p>
      </div>
    </div>
  </section>

  <!-- Voices: mapped (non-editable expressions) -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Imagined reviews</p>
        <h2>What people could say</h2>
      </div>
      <div class="grid grid-3">
        {voices.map((v) => (
          <blockquote class="quote">
            <p>&ldquo;{v.quote}&rdquo;</p>
            <p class="who">{v.who}<br /><span style="font-weight:400;color:var(--grey);">{v.role}</span></p>
          </blockquote>
        ))}
      </div>
    </div>
  </section>
</Base>
