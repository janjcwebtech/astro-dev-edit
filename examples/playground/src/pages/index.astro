---
import Base from '../layouts/Base.astro';

// Home page. Almost everything here is LITERAL text and STATIC <img> — the two
// things the editor supports today. The benefits list is a mapped array on
// purpose: it exercises the classifier's non-editable (expression) path.
const benefits = [
  { tag: 'Context', title: 'Edit where you read', body: 'Change the words on the rendered page, not in a file three folders away. What you see is what you are editing.' },
  { tag: 'Accuracy', title: 'Fewer copy mistakes', body: 'When the preview is the interface, there is no guessing which heading in the source maps to the one on screen.' },
  { tag: 'Speed', title: 'A typo takes seconds', body: 'Spot it, click it, fix it. No editor, no search, no rebuild ritual for a one-word change.' },
  { tag: 'Safety', title: 'Your repo is the undo', body: 'Every change is a plain edit to a source file in your working tree. Review it, commit it, or throw it away with git.' },
  { tag: 'Honesty', title: 'It refuses what it cannot do', body: 'Generated and templated content is declined with an explanation and a jump to the source, never silently mangled.' },
  { tag: 'Ownership', title: 'No second system', body: 'Content stays in your repository. There is no external database, no sync, and nothing new to host or back up.' },
];
---
<Base title="Copydesk · Edit your Astro site where you can see it">
  <!-- HERO: literal heading, subhead, buttons + a static image -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Visual editing for Astro</p>
        <h1>Edit your site where you can see it</h1>
        <p class="lead">
          Copydesk is a fictional site about changing your content on the page
          itself: click the text, type, and the change lands in your source
          files. This whole site is a playground, so try it on anything.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/articles">Read the articles</a>
          <a class="btn btn-ghost" href="/about">How this playground works</a>
        </div>
      </div>
      <div class="hero-media">
        <img src="/images/hero.svg" alt="A stylised page with one line of text highlighted for editing" />
      </div>
    </div>
  </section>

  <!-- BENEFITS: mapped cards (expressions — should classify as non-editable) -->
  <section class="section" id="benefits">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Why edit visually</p>
        <h2>The page is the best editor for the page</h2>
        <p>Six reasons to fix the words where the words actually are.</p>
      </div>
      <div class="grid grid-3">
        {benefits.map((b) => (
          <article class="card">
            <span class="tag">{b.tag}</span>
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURE SPLIT: literal text + static image -->
  <section class="section">
    <div class="container split">
      <img src="/images/workflow.svg" alt="A rendered preview and its source file side by side, connected by an arrow" />
      <div>
        <p class="eyebrow">One source of truth</p>
        <h2>The preview and the source stay in step</h2>
        <p>
          A visual edit is not a parallel copy of your content. It is the same
          markdown and templates your site already builds from. Change the page
          and the file changes; change the file and the page follows.
        </p>
        <a class="btn btn-dark" href="/about">More about how it works</a>
      </div>
    </div>
  </section>

  <!-- DARK CTA BAND: literal text + buttons -->
  <section class="section" id="try">
    <div class="container">
      <div class="cta-band">
        <h2>Try it on this very page</h2>
        <p>Turn on edit mode, click this sentence, and change it. That is the whole pitch.</p>
        <div class="hero-actions" style="justify-content:center;">
          <a class="btn btn-primary" href="/articles">Browse the articles</a>
          <a class="btn btn-ghost" href="/about" style="color:var(--cream);border-color:rgba(255,255,255,0.3);">About the playground</a>
        </div>
      </div>
    </div>
  </section>
</Base>
