---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /**
   * Repo-relative path to the markdown/MDX file backing this page, e.g.
   * `src/content/blog/post.md`. When set, we emit the
   * `astro-dev-edit:page-source` meta tag, which **declares** the backing entry
   * rather than letting the integration resolve it from the URL.
   *
   * Kept on /works only, on purpose. The integration now finds the entry itself
   * for any collection switched on in its Collections drawer, so /articles
   * passes nothing and exercises that path; this one stays as the fixture for
   * the declared path, which still wins wherever it is present.
   *
   * Emitted in dev only, as the contract requires: it exists for an editor
   * that never runs in a build, and a built page would be publishing its own
   * repository paths for nothing.
   */
  pageSource?: string;
}
const { title, description = 'A fictional demo site about visual editing, the astro-dev-edit playground.', pageSource } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles/global.css" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {import.meta.env.DEV && pageSource && <meta name="astro-dev-edit:page-source" content={pageSource} />}
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
